rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidInquiry(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 200
        && data.email is string && data.email.size() > 0 && data.email.size() <= 200
        && data.phone is string && data.phone.size() <= 50
        && data.eventType is string && data.eventType.size() <= 100
        && data.guestCount is number && data.guestCount >= 1 && data.guestCount <= 5000;
    }

    match /inquiries/{inquiryId} {
      allow read: if true;
      allow create: if isValidId(inquiryId) && isValidInquiry(request.resource.data);
      allow update, delete: if true;
    }

    match /proposals/{proposalId} {
      allow read: if true;
      allow create: if isValidId(proposalId);
      allow update, delete: if true;
    }

    match /test/{testId} {
      allow read, write: if true;
    }
  }
}
